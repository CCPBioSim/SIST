{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "calculation", "input", "parameters", "profile", "error"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "status": { "enum": ["success", "failed"] },
    "calculation": { "$ref": "#/$defs/calculation" },
    "input": { "$ref": "#/$defs/input" },
    "parameters": { "$ref": "#/$defs/parameters" },
    "profile": {
      "oneOf": [{ "$ref": "#/$defs/profile" }, { "type": "null" }]
    },
    "error": {
      "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } } },
      "then": {
        "properties": {
          "profile": { "type": "object" },
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": {
        "properties": {
          "profile": { "type": "null" },
          "error": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "properties": { "calculation": { "properties": { "algorithm": { "const": "M" } } } }
      },
      "then": { "$ref": "#/$defs/algorithm_M" }
    },
    {
      "if": {
        "properties": { "calculation": { "properties": { "algorithm": { "const": "Z" } } } }
      },
      "then": { "$ref": "#/$defs/algorithm_Z" }
    },
    {
      "if": {
        "properties": { "calculation": { "properties": { "algorithm": { "const": "C" } } } }
      },
      "then": { "$ref": "#/$defs/algorithm_C" }
    },
    {
      "if": {
        "properties": { "calculation": { "properties": { "algorithm": { "const": "A" } } } }
      },
      "then": { "$ref": "#/$defs/algorithm_A" }
    }
  ],
  "$defs": {
    "transition": { "enum": ["melting", "z_dna", "cruciform"] },
    "positive_number": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullable_number": {
      "type": ["number", "null"]
    },
    "position_probabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/probability" }
    },
    "calculation": {
      "type": "object",
      "required": ["algorithm", "transitions"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "enum": ["M", "Z", "C", "A"] },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["sequence_file", "sequence_length_bp", "molecule_type"],
      "additionalProperties": false,
      "properties": {
        "sequence_file": { "type": "string" },
        "sequence_length_bp": { "type": "integer", "minimum": 1 },
        "molecule_type": { "enum": ["linear", "circular"] }
      }
    },
    "parameters": {
      "type": "object",
      "required": [
        "temperature_k",
        "superhelical_density",
        "salt_concentration_m",
        "energy_threshold_kcal_per_mol",
        "melting_energetics"
      ],
      "additionalProperties": false,
      "properties": {
        "temperature_k": { "$ref": "#/$defs/positive_number" },
        "superhelical_density": { "type": "number", "maximum": 0 },
        "salt_concentration_m": { "$ref": "#/$defs/positive_number" },
        "energy_threshold_kcal_per_mol": { "$ref": "#/$defs/positive_number" },
        "melting_energetics": { "enum": ["copolymeric", "nearest_neighbor", null] }
      }
    },
    "profile": {
      "type": "object",
      "required": ["probability"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string", "pattern": "^[ACGT]*$" },
        "probability": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "melting": { "$ref": "#/$defs/position_probabilities" },
            "z_dna": { "$ref": "#/$defs/position_probabilities" },
            "cruciform": { "$ref": "#/$defs/position_probabilities" }
          }
        },
        "free_energy_kcal_per_mol": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "melting": {
              "type": "array",
              "items": { "$ref": "#/$defs/nullable_number" }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "algorithm_M": {
      "properties": {
        "calculation": { "properties": { "transitions": { "const": ["melting"] } } },
        "profile": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "probability": { "required": ["melting"], "maxProperties": 1 }
            }
          }
        }
      }
    },
    "algorithm_Z": {
      "properties": {
        "calculation": { "properties": { "transitions": { "const": ["z_dna"] } } },
        "profile": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "probability": { "required": ["z_dna"], "maxProperties": 1 }
            },
            "not": { "required": ["free_energy_kcal_per_mol"] }
          }
        }
      }
    },
    "algorithm_C": {
      "properties": {
        "calculation": { "properties": { "transitions": { "const": ["cruciform"] } } },
        "profile": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "probability": { "required": ["cruciform"], "maxProperties": 1 }
            },
            "not": { "required": ["free_energy_kcal_per_mol"] }
          }
        }
      }
    },
    "algorithm_A": {
      "properties": {
        "calculation": { "properties": { "transitions": { "const": ["melting", "z_dna", "cruciform"] } } },
        "profile": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "probability": { "required": ["melting", "z_dna", "cruciform"], "maxProperties": 3 }
            },
            "not": { "required": ["free_energy_kcal_per_mol"] }
          }
        }
      }
    }
  }
}
