{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CCPBioSim/SIST/main/src/sist/schemas/sist-result-v1.schema.json",
  "title": "SIST result",
  "description": "Structured result of one SIST calculation, version 1. Accepts any schema_version 1.x.y.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "provenance",
    "calculation",
    "input",
    "parameters",
    "derived_parameters",
    "summary",
    "profile",
    "warnings",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": {
      "description": "Version of the result model, as MAJOR.MINOR.PATCH.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": { "enum": ["success", "failed"] },
    "provenance": { "$ref": "#/$defs/provenance" },
    "calculation": { "$ref": "#/$defs/calculation" },
    "input": { "$ref": "#/$defs/input" },
    "parameters": { "$ref": "#/$defs/parameters" },
    "derived_parameters": {
      "oneOf": [{ "$ref": "#/$defs/derived_parameters" }, { "type": "null" }]
    },
    "summary": {
      "oneOf": [{ "$ref": "#/$defs/summary" }, { "type": "null" }]
    },
    "profile": {
      "oneOf": [{ "$ref": "#/$defs/profile" }, { "type": "null" }]
    },
    "inverted_repeats": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/inverted_repeat" } },
        { "type": "null" }
      ]
    },
    "diagnostics": {
      "oneOf": [{ "$ref": "#/$defs/diagnostics" }, { "type": "null" }]
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    },
    "error": {
      "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } } },
      "then": {
        "properties": {
          "derived_parameters": { "type": "object" },
          "summary": { "type": "object" },
          "profile": { "type": "object" },
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": {
        "properties": {
          "summary": { "type": "null" },
          "profile": { "type": "null" },
          "error": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "properties": { "calculation": { "properties": { "algorithm": { "const": "M" } } } }
      },
      "then": { "$ref": "#/$defs/algorithm_M" }
    },
    {
      "if": {
        "properties": { "calculation": { "properties": { "algorithm": { "const": "Z" } } } }
      },
      "then": { "$ref": "#/$defs/algorithm_Z" }
    },
    {
      "if": {
        "properties": { "calculation": { "properties": { "algorithm": { "const": "C" } } } }
      },
      "then": { "$ref": "#/$defs/algorithm_C" }
    },
    {
      "if": {
        "properties": { "calculation": { "properties": { "algorithm": { "const": "A" } } } }
      },
      "then": { "$ref": "#/$defs/algorithm_A" }
    }
  ],
  "$defs": {
    "transition": { "enum": ["melting", "z_dna", "cruciform"] },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "timestamp": { "type": ["string", "null"], "format": "date-time" },
    "positive_number": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullable_probability": {
      "oneOf": [{ "$ref": "#/$defs/probability" }, { "type": "null" }]
    },
    "nullable_number": {
      "type": ["number", "null"]
    },
    "position_probabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/probability" }
    },
    "calculation": {
      "type": "object",
      "required": ["algorithm", "transitions"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "enum": ["M", "Z", "C", "A"] },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["sequence_file", "sequence_length_bp", "molecule_type"],
      "additionalProperties": false,
      "properties": {
        "sequence_file": { "type": "string" },
        "sequence_name": { "type": ["string", "null"] },
        "sequence_length_bp": { "type": "integer", "minimum": 1 },
        "sequence_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "molecule_type": { "enum": ["linear", "circular"] }
      }
    },
    "parameters": {
      "type": "object",
      "required": [
        "temperature_k",
        "superhelical_density",
        "salt_concentration_m",
        "energy_threshold_kcal_per_mol",
        "melting_energetics"
      ],
      "additionalProperties": false,
      "properties": {
        "temperature_k": { "$ref": "#/$defs/positive_number" },
        "superhelical_density": { "type": "number", "maximum": 0 },
        "salt_concentration_m": { "$ref": "#/$defs/positive_number" },
        "energy_threshold_kcal_per_mol": { "$ref": "#/$defs/positive_number" },
        "melting_energetics": { "enum": ["copolymeric", "nearest_neighbor", null] },
        "cruciform_salt_concentration_m": {
          "oneOf": [{ "$ref": "#/$defs/positive_number" }, { "type": "null" }]
        }
      }
    },
    "per_transition_number": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "melting": { "type": "number" },
        "z_dna": { "type": "number" },
        "cruciform": { "type": "number" }
      }
    },
    "derived_parameters": {
      "type": "object",
      "required": [
        "linking_difference_turns",
        "torsional_stiffness_kcal_bp_per_rad2",
        "nucleation_energy_kcal_per_mol",
        "bat_kcal_per_mol",
        "bgc_kcal_per_mol"
      ],
      "additionalProperties": false,
      "properties": {
        "linking_difference_turns": { "type": "number" },
        "torsional_stiffness_kcal_bp_per_rad2": { "$ref": "#/$defs/positive_number" },
        "nucleation_energy_kcal_per_mol": { "$ref": "#/$defs/per_transition_number" },
        "bat_kcal_per_mol": { "$ref": "#/$defs/nullable_number" },
        "bgc_kcal_per_mol": { "$ref": "#/$defs/nullable_number" }
      }
    },
    "inverted_repeat": {
      "type": "object",
      "required": ["start", "length_bp", "energy_kcal_per_mol"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "length_bp": { "type": "integer", "minimum": 1 },
        "energy_kcal_per_mol": { "type": "number" }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "scaling_factor": { "type": "number" },
        "energy_window": {
          "type": "object",
          "required": ["min_energy_kcal_per_mol", "max_energy_kcal_per_mol"],
          "additionalProperties": false,
          "properties": {
            "min_energy_kcal_per_mol": { "type": "number" },
            "max_energy_kcal_per_mol": { "type": "number" }
          }
        }
      }
    },
    "state_counts": {
      "type": "object",
      "required": ["one_run", "two_run", "three_run", "four_run", "total"],
      "additionalProperties": false,
      "properties": {
        "one_run": { "type": "integer", "minimum": 0 },
        "two_run": { "type": "integer", "minimum": 0 },
        "three_run": { "type": "integer", "minimum": 0 },
        "four_run": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "transition_summary": {
      "type": "object",
      "required": ["probability", "expected_runs", "expected_transformed_bp"],
      "additionalProperties": false,
      "properties": {
        "probability": { "$ref": "#/$defs/probability" },
        "expected_runs": { "type": "number", "minimum": 0 },
        "expected_transformed_bp": { "type": "number", "minimum": 0 }
      }
    },
    "pair_matrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "melting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "z_dna": { "$ref": "#/$defs/nullable_probability" },
            "cruciform": { "$ref": "#/$defs/nullable_probability" }
          }
        },
        "z_dna": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "melting": { "$ref": "#/$defs/nullable_probability" },
            "cruciform": { "$ref": "#/$defs/nullable_probability" }
          }
        },
        "cruciform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "melting": { "$ref": "#/$defs/nullable_probability" },
            "z_dna": { "$ref": "#/$defs/nullable_probability" }
          }
        }
      }
    },
    "pairwise": {
      "type": "object",
      "required": ["joint_probability", "conditional_probability", "conditional_probability_given_absent"],
      "additionalProperties": false,
      "properties": {
        "joint_probability": { "$ref": "#/$defs/pair_matrix" },
        "conditional_probability": { "$ref": "#/$defs/pair_matrix" },
        "conditional_probability_given_absent": { "$ref": "#/$defs/pair_matrix" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "ln_partition_function",
        "partition_function",
        "average_number_of_runs",
        "state_counts",
        "transitions"
      ],
      "additionalProperties": false,
      "properties": {
        "ln_partition_function": { "type": "number" },
        "partition_function": { "$ref": "#/$defs/nullable_number" },
        "average_number_of_runs": { "type": "number", "minimum": 0 },
        "state_counts": { "$ref": "#/$defs/state_counts" },
        "transitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "melting": { "$ref": "#/$defs/transition_summary" },
            "z_dna": { "$ref": "#/$defs/transition_summary" },
            "cruciform": { "$ref": "#/$defs/transition_summary" }
          }
        },
        "pairwise": { "$ref": "#/$defs/pairwise" }
      }
    },
    "profile": {
      "type": "object",
      "required": ["probability"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string", "pattern": "^[ACGT]*$" },
        "probability": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "melting": { "$ref": "#/$defs/position_probabilities" },
            "z_dna": { "$ref": "#/$defs/position_probabilities" },
            "cruciform": { "$ref": "#/$defs/position_probabilities" }
          }
        },
        "free_energy_kcal_per_mol": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "melting": {
              "type": "array",
              "items": { "$ref": "#/$defs/nullable_number" }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["software", "environment", "command", "started_at", "finished_at", "wall_time_s"],
      "additionalProperties": false,
      "properties": {
        "software": {
          "type": "object",
          "required": ["name", "version", "git_sha", "engine", "irf_version"],
          "additionalProperties": false,
          "properties": {
            "name": { "const": "SIST" },
            "version": { "type": "string", "minLength": 1 },
            "git_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
            "engine": { "enum": ["trans_three", "trans_compete", null] },
            "irf_version": { "type": ["string", "null"] }
          }
        },
        "environment": {
          "type": "object",
          "required": ["python", "platform"],
          "additionalProperties": false,
          "properties": {
            "python": { "type": "string" },
            "platform": { "type": "string" }
          }
        },
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestamp" },
        "wall_time_s": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "warning": {
      "type": "object",
      "required": ["code", "message", "source"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "message": { "type": "string" },
        "source": { "enum": ["sist", "ir_finder", "qsidd"] },
        "details": { "type": "object" }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "stage"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "message": { "type": "string" },
        "stage": { "enum": ["validation", "input", "ir_finder", "qsidd", "output", "internal"] },
        "exit_code": { "type": ["integer", "null"] },
        "stderr": { "type": ["string", "null"] },
        "details": { "type": "object" }
      }
    },
    "algorithm_M": {
      "properties": {
        "calculation": { "properties": { "transitions": { "const": ["melting"] } } },
        "summary": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "transitions": { "required": ["melting"], "maxProperties": 1 }
            },
            "not": { "required": ["pairwise"] }
          }
        },
        "profile": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "probability": { "required": ["melting"], "maxProperties": 1 }
            }
          }
        }
      }
    },
    "algorithm_Z": {
      "properties": {
        "calculation": { "properties": { "transitions": { "const": ["z_dna"] } } },
        "summary": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "transitions": { "required": ["z_dna"], "maxProperties": 1 }
            },
            "not": { "required": ["pairwise"] }
          }
        },
        "profile": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "probability": { "required": ["z_dna"], "maxProperties": 1 }
            },
            "not": { "required": ["free_energy_kcal_per_mol"] }
          }
        }
      }
    },
    "algorithm_C": {
      "properties": {
        "calculation": { "properties": { "transitions": { "const": ["cruciform"] } } },
        "summary": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "transitions": { "required": ["cruciform"], "maxProperties": 1 }
            },
            "not": { "required": ["pairwise"] }
          }
        },
        "profile": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "probability": { "required": ["cruciform"], "maxProperties": 1 }
            },
            "not": { "required": ["free_energy_kcal_per_mol"] }
          }
        }
      }
    },
    "algorithm_A": {
      "properties": {
        "calculation": { "properties": { "transitions": { "const": ["melting", "z_dna", "cruciform"] } } },
        "summary": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "transitions": { "required": ["melting", "z_dna", "cruciform"], "maxProperties": 3 }
            }
          }
        },
        "profile": {
          "if": { "type": "object" },
          "then": {
            "properties": {
              "probability": { "required": ["melting", "z_dna", "cruciform"], "maxProperties": 3 }
            },
            "not": { "required": ["free_energy_kcal_per_mol"] }
          }
        }
      }
    }
  }
}
